# Base URL of the store API.
# Leave as /api to use the built-in Nuxt mock backend (server/api).
# Point it at the real backend when it is ready, e.g. https://api.iz-store.com
NUXT_PUBLIC_API_BASE=/api

# Absolute site URL, used for canonical links and OpenGraph tags.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
